# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Placeholders only in THIS file.
# A leaked key is revoked and may affect your submission. Remove debug credentials before you submit.

# --- Server & Deployment (Railway / Cloud) -----------------------------------
# PORT=8100               # Assigned automatically by Railway. Defaults to 8100 locally.
# HOST=0.0.0.0            # Bind address. Defaults to 0.0.0.0.
# CORS_ORIGINS=           # Comma-separated list of allowed frontend origins:
                          # e.g., https://cube-round3-pod.vercel.app,http://localhost:5173
# CORS_ALLOW_VERCEL_PREVIEWS=true # Automatically permit *.vercel.app preview URLs

# --- Orchestration -----------------------------------------------------------
# ORCH_MODE=inproc        # blank or "inproc": runs agents in-process. "http": external HTTP microservices.
# ORCH_FLOW=              # blank: uses flow named in pod.json (orchestration/flow.specialist.json)
# OUT_DIR=out             # Where workflow state and evidence are written (workflows/, evidence/)
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING
LOG_FORMAT=json           # json | text

# --- Data --------------------------------------------------------------------
# DATA_DIR=data/sample    # Where sample CSVs are located (returns_sample.csv, etc.)
# INPUT_DIR=data/input    # Per-stage captures: <INPUT_DIR>/<subject_id>/<stage>/<file>

# --- Agent services (only if running individual agents in HTTP mode) ---------
# RECEIVING_URL=http://localhost:8101
# PACK_URL=http://localhost:8103
# RETURNS_URL=http://localhost:8104
# RECOVERY_URL=http://localhost:8105

# --- Model providers (Google Gemini / OpenRouter multimodal vision) ----------
# GEMINI_API_KEY=your-gemini-key-here
# OPENROUTER_API_KEY=your-openrouter-key-here
# GEMINI_MODEL=gemini-3.5-flash
# VISION_PROVIDER=gemini  # gemini | openrouter
# GOOGLE_API_KEY=your-gemini-key-here     # alternative name for the Gemini key
# GEMINI_BUDGET_SECONDS=120               # Pack: total time budget for model calls (default 120s)
# GEMINI_REQUEST_TIMEOUT_SECONDS=         # Pack: per-request timeout
# OPENROUTER_MODEL=                       # Returns: OpenRouter model id (prefer a ":free" model)
# VISION_MODEL=                           # Returns: vision model override
# Without any key, Pack and Returns fail open (UNCERTAIN -> human review); they never guess.
